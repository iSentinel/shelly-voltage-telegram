# Shelly Pro EM-50
SHELLY_METER_TYPE=pro_em50
SHELLY_HOST=192.168.1.50
SHELLY_EM1_ID=0
SHELLY_USERNAME=admin
SHELLY_PASSWORD=
SHELLY_PASSWORD_FILE=/run/secrets/shelly_password
SHELLY_TIMEOUT_SEC=4

# Legacy secondary sensor fields (preserved; inactive for selected models)
PHASE_L2_HOST=
PHASE_L2_EM1_ID=0
PHASE_L2_USERNAME=admin
PHASE_L2_PASSWORD=
PHASE_L2_PASSWORD_FILE=/run/secrets/shelly_l2_password
PHASE_L3_HOST=
PHASE_L3_EM1_ID=0
PHASE_L3_USERNAME=admin
PHASE_L3_PASSWORD=
PHASE_L3_PASSWORD_FILE=/run/secrets/shelly_l3_password

# Telegram is optional. Prefer secret files in production.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_token
TELEGRAM_CHAT_ID=
TELEGRAM_CHAT_ID_FILE=/run/secrets/telegram_chat_id
TELEGRAM_STATUS_CHAT_ID=
TELEGRAM_PIN_STATUS=false
TELEGRAM_UPDATE_INTERVAL_SEC=60
TELEGRAM_MIN_EDIT_INTERVAL_SEC=15
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_PERSIST_UPDATE_OFFSET=true
TELEGRAM_SILENT_BY_DEFAULT=true
TELEGRAM_LANGUAGE=ru
TELEGRAM_QUIET_START_HOUR=23
TELEGRAM_QUIET_END_HOUR=7
VOLTAGE_NOTIFICATION_COOLDOWN_MIN=5
VOLTAGE_STATUS_EDIT_WINDOW_MIN=10
VOLTAGE_INSTABILITY_ENABLED=true
LOW_VOLTAGE_ALERT_ENABLED=true
LOW_VOLTAGE_ALERT_V=180
LOW_VOLTAGE_RECOVERY_V=185
SIGNIFICANT_CHANGE_V=0.5

# Monitoring
POLL_INTERVAL_SEC=10
RETENTION_DAYS=90
DATABASE_PATH=/data/voltage.sqlite3
TIMEZONE=Europe/Kyiv
STALE_AFTER_SEC=45
SHELLY_OFFLINE_AFTER_FAILURES=3
SHELLY_RECOVERY_AFTER_SUCCESSES=2
SHELLY_OFFLINE_LOG_INTERVAL_SEC=300
AVAILABILITY_ALERTS_ENABLED=true

# Health endpoint
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080

# Optional alerts. Disabled by default.
ALERTS_ENABLED=true
WARNING_LOW_V=207
WARNING_HIGH_V=253
CRITICAL_LOW_V=190
CRITICAL_HIGH_V=255
ALERT_DWELL_SEC=15
ALERT_RECOVERY_DWELL_SEC=30
DAILY_SUMMARY_ENABLED=true
DAILY_SUMMARY_HOUR=22
DAILY_SUMMARY_MINUTE=55

LOG_LEVEL=INFO
TZ=Europe/Kyiv
