[Unit]
Description=Shelly Pro EM-50 Voltage Monitor Compose Stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/shelly-voltage
ExecStart=/bin/bash /opt/shelly-voltage/scripts/apply-update.sh --guarded-start
ExecReload=/bin/bash /opt/shelly-voltage/scripts/apply-update.sh --guarded-start
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
