[Unit]
Description=Check Shelly Voltage Telegram GitHub releases (read only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=shelly-voltage-update-check
StateDirectoryMode=0750
# PID1 copies only the public checker and version into a private,
# read-only credential directory for this short-lived DynamicUser.
# Do not grant traversal of the protected application or secret paths.
WorkingDirectory=/
LoadCredential=github_update.py:/opt/shelly-voltage/scripts/github_update.py
LoadCredential=RELEASE_VERSION:/opt/shelly-voltage/RELEASE_VERSION
ExecStart=/usr/bin/python3 %d/github_update.py check --root %d
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
