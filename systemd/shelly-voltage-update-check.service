[Unit]
Description=Check Shelly Voltage Telegram GitHub releases (read only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=shelly-voltage-release-check
StateDirectoryMode=0750
LoadCredential=checker.py:/opt/shelly-voltage/scripts/github_update.py
LoadCredential=VERSION:/opt/shelly-voltage/VERSION
LoadCredential=RELEASE_VERSION:/opt/shelly-voltage/RELEASE_VERSION
LoadCredential=deployed.json:/var/lib/shelly-voltage-update-check/deployed.json
SetCredential=RELEASE_VERSION:shelly-version-not-provisioned
SetCredential=deployed.json:shelly-version-not-provisioned
ExecStart=/usr/bin/python3 ${CREDENTIALS_DIRECTORY}/checker.py check --credentials ${CREDENTIALS_DIRECTORY} --status-file ${STATE_DIRECTORY}/status.json
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
